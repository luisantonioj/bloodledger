                "institutionId": {
                  "type": "string"
                },
                "scheduledFor": {
                  "type": "string",
                  "format": "date-time"
                },
                "capturedAt": {
                  "type": "string",
                  "format": "date-time"
                },
                "reportPolicyVersion": {
                  "type": "string"
                },
                "triggerType": {
                  "type": "string"
                },
                "classification": {
                  "const": "SIMULATION_ONLY"
                }
              },
              "additionalProperties": false
            }
          },
          "nextCursor": {
            "type": [
              "string",
              "null"
            ]
          },
          "exportAvailable": {
            "type": "boolean"
          },
          "classification": {
            "const": "SIMULATION_ONLY"
          }
        },
        "additionalProperties": false
      },
      "Command": {
        "type": "object",
        "required": [
          "commandId",
          "resourceType",
          "resourceId",
          "status",
          "statusUrl",
          "acceptedAt",
          "correlationId",
          "classification",
          "replayed"
        ],
        "properties": {
          "commandId": {
            "type": "string"
          },
          "resourceType": {
            "type": "string",
            "enum": [
              "COMPONENT",
              "INBOUND_CAPTURE",
              "TRANSFER",
              "LOCAL_RELEASE",
              "RECONCILIATION"
            ]
          },
          "resourceId": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "QUEUED",
              "SUBMITTING",
              "LEDGER_COMMITTED_PROJECTION_PENDING",
              "COMMITTED",
              "RETRY_WAIT",
              "FAILED",
              "CONFLICT"
            ]
          },
          "statusUrl": {
            "type": "string"
          },
          "acceptedAt": {
            "type": "string",
            "format": "date-time"
          },
          "correlationId": {
            "type": "string"
          },
          "safeErrorCode": {
            "type": [
              "string",
              "null"
            ]
          },
          "classification": {
            "const": "SIMULATION_ONLY"
          },
          "replayed": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      },
      "CommandRecovery": {
        "type": "object",
        "required": [
          "scope",
          "commands",
          "nextCursor",
          "classification"
