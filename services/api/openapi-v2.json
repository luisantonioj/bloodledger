                  "type": "string",
                  "enum": [
                    "SOURCE_INSTITUTION",
                    "DESTINATION_INSTITUTION"
                  ]
                },
                "reservations": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Reservation"
                  }
                },
                "nextCursor": {
                  "type": [
