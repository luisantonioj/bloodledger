{
  "openapi": "3.1.0",
  "info": {
    "title": "BloodLedger Interview Core V2 API",
    "version": "0.1.0",
    "description": "Simulation-only additive contracts for the interview-aligned core. Frontend and forecasting implementations are separate workstreams."
  },
  "servers": [
    {
      "url": "/api/v2"
    }
  ],
  "security": [
    {
      "cookieAuth": []
    }
  ],
  "paths": {
    "/commands": {
      "get": {
        "operationId": "listRecoverableCommands",
        "description": "Recover safe command envelopes created by the authenticated actor in the authenticated institution. Request payloads are never returned.",
        "parameters": [
          {
            "$ref": "#/components/parameters/PageLimit"
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^CMD_[A-Z0-9_-]{1,56}$"
            }
          },
          {
            "name": "idempotencyKey",
            "in": "query",
            "required": false,
            "description": "Exact recovery lookup for a key created by the authenticated actor.",
            "schema": {
              "type": "string",
              "pattern": "^IDEM_[A-Z0-9_-]{1,59}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Actor- and institution-scoped safe command envelopes",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CommandRecovery"
                }
              }
            }
          }
        }
      }
    },
    "/commands/{commandId}": {
      "get": {
        "operationId": "getCommand",
        "parameters": [
          {
            "$ref": "#/components/parameters/CommandId"
          }
        ],
        "responses": {
          "200": {
            "$ref": "#/components/responses/Command"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/components": {
      "post": {
        "operationId": "registerComponent",
        "deprecated": true,
        "description": "Legacy mutation retained only to return V2_OCR_REQUIRED. Use OCR-only inbound-captures.",
        "responses": {
          "410": {
            "description": "Legacy component mutation is disabled; confirmed OCR is required"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ComponentRegistration"
              }
            }
          }
        }
      },
      "get": {
        "operationId": "listComponents",
        "parameters": [
          {
            "$ref": "#/components/parameters/ContractVersion"
          }
        ],
        "responses": {
          "200": {
            "$ref": "#/components/responses/Components"
          }
        }
      }
    },
    "/components/{componentId}": {
      "get": {
        "operationId": "getComponent",
        "parameters": [
          {
            "$ref": "#/components/parameters/ContractVersion"
          },
          {
            "name": "componentId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^COMP_[A-Z0-9_-]{1,56}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "A component in the authorized institution scope"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/inbound-captures": {
      "post": {
        "operationId": "acceptInboundOcrCapture",
        "description": "Accept a confirmed OCR capture. The receiving custody institution is derived from the authenticated session; raw OCR text and images are not accepted.",
        "parameters": [
          {
            "$ref": "#/components/parameters/ContractVersion"
          },
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ],
        "responses": {
          "200": {
            "description": "Already registered in the same custody scope"
          },
          "202": {
            "$ref": "#/components/responses/Command"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/InboundOcrCapture"
              }
            }
          }
        }
      }
    },
    "/transfers": {
      "post": {
        "operationId": "submitTransfer",
        "parameters": [
          {
            "$ref": "#/components/parameters/ContractVersion"
          },
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ],
        "responses": {
          "202": {
            "$ref": "#/components/responses/Command"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TransferRequest"
              }
            }
          }
        }
      }
    },
    "/transfers/{transferId}/{action}": {
      "post": {
        "operationId": "transitionTransfer",
        "description": "Legacy transfer action aliases are intentionally rejected. Use /reservations/{reservationId}/{action} for the canonical custody workflow.",
        "parameters": [
          {
            "$ref": "#/components/parameters/ContractVersion"
          },
          {
            "name": "transferId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^TRF_[A-Z0-9_-]{1,56}$"
            }
          },
          {
            "name": "action",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "approve",
                "prepare",
                "dispatch",
                "transit",
                "receipt",
                "delay",
                "compromise",
                "cancel",
                "reject"
              ]
            }
          }
        ],
        "responses": {
          "410": {
            "description": "Legacy transfer action is disabled; the canonical reservation workflow is required"
          }
        }
      }
    },
    "/reports/doh-census/catch-up": {
      "post": {
        "operationId": "captureDohCensusCatchUp",
        "description": "Manual authorized catch-up. The report policy and blood-type column order must be approved before this route is enabled.",
        "responses": {
          "201": {
            "$ref": "#/components/responses/Census"
          },
          "503": {
            "$ref": "#/components/responses/PolicyDisabled"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CensusCatchUpRequest"
              }
            }
          }
        }
      }
    },
    "/reports/doh-census": {
      "get": {
        "operationId": "listCensusSnapshots",
        "description": "Discover existing safe census snapshot metadata. Discovery does not activate capture or export.",
        "parameters": [
          {
            "$ref": "#/components/parameters/PageLimit"
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^CENSUS_[A-Z0-9_-]{1,56}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Authorized snapshot index and report availability",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CensusIndex"
                }
              }
            }
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          }
        }
      }
    },
    "/reports/doh-census/{snapshotId}": {
      "get": {
        "operationId": "getCensusSnapshot",
        "parameters": [
          {
            "$ref": "#/components/parameters/SnapshotId"
          }
        ],
        "responses": {
          "200": {
            "$ref": "#/components/responses/Census"
          }
        }
      }
    },
    "/reports/inbound-intake": {
      "get": {
        "operationId": "getInboundIntakeStatus",
        "description": "Aggregate OCR intake states. Raw Donation Nos. are never returned.",
        "responses": {
          "200": {
            "description": "Inbound intake status metrics"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          }
        }
      }
    },
    "/reports/doh-census/{snapshotId}/{componentType}.tsv": {
      "get": {
        "operationId": "copyCensusRow",
        "parameters": [
          {
            "$ref": "#/components/parameters/SnapshotId"
          },
          {
            "name": "componentType",
            "in": "path",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/ComponentType"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Versioned TSV row",
            "content": {
              "text/tab-separated-values": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "409": {
            "$ref": "#/components/responses/PolicyDisabled"
          }
        }
      }
    },
    "/local-releases": {
      "post": {
        "operationId": "reserveLocalRelease",
        "description": "Queue a local-release reservation. ROLE-01 and ROLE-02 only.",
        "parameters": [
          {
            "$ref": "#/components/parameters/ContractVersion"
          },
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ],
        "responses": {
          "202": {
            "$ref": "#/components/responses/Command"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LocalReleaseRequest"
              }
            }
          }
        }
      }
    },
    "/reconciliation": {
      "get": {
        "operationId": "listReconciliationReasons",
        "description": "Return the active synthetic hold-reason policy for ROLE-01 and ROLE-02.",
        "responses": {
          "200": {
            "description": "Versioned reconciliation reason policy",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReconciliationReasonPolicy"
                }
              }
            }
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          }
        }
      },
      "post": {
        "operationId": "placeReconciliationHold",
        "description": "Queue a reconciliation hold. ROLE-01 and ROLE-02 only.",
        "parameters": [
          {
            "$ref": "#/components/parameters/ContractVersion"
          },
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ],
        "responses": {
          "202": {
            "$ref": "#/components/responses/Command"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReconciliationRequest"
              }
            }
          }
        }
      }
    },
    "/reservations": {
      "get": {
        "operationId": "listReservations",
        "description": "List committed reservation projections in the authenticated source or destination institution scope.",
        "parameters": [
          {
            "$ref": "#/components/parameters/ContractVersion"
          },
          {
            "$ref": "#/components/parameters/PageLimit"
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^RES_[A-Z0-9_-]{1,56}$"
            }
          }
        ],
        "responses": {
          "200": {
            "$ref": "#/components/responses/Reservations"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "409": {
            "description": "V2.1 is required when the reservation contains cryoprecipitate"
          }
        }
      }
    },
    "/reservations/{reservationId}": {
      "get": {
        "operationId": "getReservation",
        "description": "Read a committed reservation projection in the authenticated institution scope.",
        "parameters": [
          {
            "$ref": "#/components/parameters/ContractVersion"
          },
          {
            "$ref": "#/components/parameters/ReservationId"
          }
        ],
        "responses": {
          "200": {
            "description": "Scoped reservation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Reservation"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "description": "V2.1 is required when the reservation contains cryoprecipitate"
          }
        }
      }
    },
    "/reservations/{reservationId}/{action}": {
      "post": {
        "operationId": "transitionReservation",
        "parameters": [
          {
            "$ref": "#/components/parameters/ContractVersion"
          },
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          },
          {
            "$ref": "#/components/parameters/ReservationId"
          },
          {
            "name": "action",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "prepare",
                "dispatch",
                "transit",
                "receive",
                "cancel",
                "compromise",
                "local-release-complete"
              ]
            }
          }
        ],
        "responses": {
          "202": {
            "$ref": "#/components/responses/Command"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReservationActionRequest"
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "cookieAuth": {
        "type": "apiKey",
        "in": "cookie",
        "name": "bloodledger_session"
      }
    },
    "parameters": {
      "ContractVersion": {
        "name": "x-bloodledger-contract-version",
        "in": "header",
        "required": false,
        "description": "V2 by default. Set V2.1 to enable the additive CRYOPRECIPITATE contract; V2 behavior remains unchanged.",
        "schema": {
          "type": "string",
          "enum": [
            "V2",
            "V2.1"
          ],
          "default": "V2"
        }
      },
      "IdempotencyKey": {
        "name": "Idempotency-Key",
        "in": "header",
        "required": true,
        "description": "Stable replay key for this mutation. Reuse only with the identical request payload.",
        "schema": {
          "type": "string",
          "pattern": "^IDEM_[A-Z0-9_-]{1,59}$"
        }
      },
      "CommandId": {
        "name": "commandId",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "pattern": "^CMD_[A-Z0-9_-]{1,56}$"
        }
      },
      "SnapshotId": {
        "name": "snapshotId",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "pattern": "^CENSUS_[A-Z0-9_-]{1,56}$"
        }
      },
      "ReservationId": {
        "name": "reservationId",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "pattern": "^RES_[A-Z0-9_-]{1,56}$"
        }
      },
      "PageLimit": {
        "name": "limit",
        "in": "query",
        "required": false,
        "schema": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 50
        }
      }
    },
    "schemas": {
      "BloodType": {
        "type": "string",
        "enum": [
          "A_POSITIVE",
          "A_NEGATIVE",
          "B_POSITIVE",
          "B_NEGATIVE",
          "AB_POSITIVE",
          "AB_NEGATIVE",
          "O_POSITIVE",
          "O_NEGATIVE"
        ]
      },
      "ComponentType": {
        "type": "string",
        "enum": [
          "WHOLE_BLOOD",
          "PACKED_RED_BLOOD_CELLS",
          "FRESH_FROZEN_PLASMA",
          "PLATELETS"
        ]
      },
      "ComponentTypeV21": {
        "type": "string",
        "description": "The additive V2.1 component vocabulary. CRYOPRECIPITATE is rejected by V2.",
        "enum": [
          "WHOLE_BLOOD",
          "PACKED_RED_BLOOD_CELLS",
          "FRESH_FROZEN_PLASMA",
          "PLATELETS",
          "CRYOPRECIPITATE"
        ]
      },
      "ComponentRegistration": {
        "type": "object",
        "required": [
          "issuerInstitutionId",
          "donationId",
          "donationNumber",
          "componentType",
          "bloodType",
          "collectedAt",
          "expiresAt",
          "eventTime",
          "correlationId"
        ],
        "properties": {
          "issuerInstitutionId": {
            "type": "string"
          },
          "donationId": {
            "type": "string",
            "pattern": "^DON_[A-Z0-9_-]{1,56}$"
          },
          "donationNumber": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "componentType": {
            "$ref": "#/components/schemas/ComponentType"
          },
          "bloodType": {
            "$ref": "#/components/schemas/BloodType"
          },
          "collectedAt": {
            "type": "string",
            "format": "date-time"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "eventTime": {
            "type": "string",
            "format": "date-time"
          },
          "correlationId": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "InboundOcrCapture": {
        "type": "object",
        "required": [
          "captureMethod",
          "capturePolicyVersion",
          "issuerInstitutionId",
          "donationNumber",
          "bloodType",
          "bloodTypeEvidence",
          "componentType",
          "componentEvidence",
          "collectedAt",
          "expiresAt",
          "capturedAt",
          "confirmedAt",
          "eventTime",
          "correlationId",
          "ocrEvidence"
        ],
        "properties": {
          "captureMethod": {
            "const": "OCR"
          },
          "capturePolicyVersion": {
            "const": "INBOUND_OCR_V1"
          },
          "issuerInstitutionId": {
            "type": "string",
            "pattern": "^INST_[A-Z0-9_-]{1,59}$"
          },
          "donationNumber": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "bloodType": {
            "$ref": "#/components/schemas/BloodType"
          },
          "bloodTypeEvidence": {
            "type": "object",
            "required": [
              "source",
              "confirmed"
            ],
            "properties": {
              "source": {
                "enum": [
                  "OCR_LABEL",
                  "OPERATOR_CONFIRMED"
                ]
              },
              "confirmed": {
                "const": true
              }
            },
            "additionalProperties": false
          },
          "componentType": {
            "$ref": "#/components/schemas/ComponentType"
          },
          "componentEvidence": {
            "type": "object",
            "required": [
              "source",
              "confirmed"
            ],
            "properties": {
              "source": {
                "enum": [
                  "OCR_LABEL",
                  "BAG_TYPE",
                  "OPERATOR_CONFIRMED"
                ]
              },
              "confirmed": {
                "const": true
              }
            },
            "additionalProperties": false
          },
          "collectedAt": {
            "type": "string",
            "format": "date-time"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "capturedAt": {
            "type": "string",
            "format": "date-time"
          },
          "confirmedAt": {
            "type": "string",
            "format": "date-time"
          },
          "eventTime": {
            "type": "string",
            "format": "date-time"
          },
          "correlationId": {
            "type": "string",
            "pattern": "^CORR_[0-9A-F]{32}$"
          },
          "ocrEvidence": {
            "type": "object",
            "required": [
              "engine",
              "engineVersion",
              "fieldConfidence"
            ],
            "properties": {
              "engine": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "engineVersion": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "fieldConfidence": {
                "type": "object",
                "required": [
                  "donationNumber",
                  "bloodType",
                  "collectedAt",
                  "expiresAt"
                ],
                "properties": {
                  "donationNumber": {
                    "type": "integer",
                    "minimum": 90,
                    "maximum": 100
                  },
                  "bloodType": {
                    "type": "integer",
                    "minimum": 90,
                    "maximum": 100
                  },
                  "collectedAt": {
                    "type": "integer",
                    "minimum": 90,
                    "maximum": 100
                  },
                  "expiresAt": {
                    "type": "integer",
                    "minimum": 90,
                    "maximum": 100
                  }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      },
      "TransferRequest": {
        "type": "object",
        "required": [
          "transferId",
          "sourceInstitutionId",
          "destinationInstitutionId",
          "bloodType",
          "componentType",
          "quantity",
          "urgency",
          "requestTime",
          "eventTime",
          "correlationId"
        ],
        "properties": {
          "transferId": {
            "type": "string",
            "pattern": "^TRF_[A-Z0-9_-]{1,56}$"
          },
          "sourceInstitutionId": {
            "type": "string",
            "pattern": "^INST_[A-Z0-9_-]{1,59}$"
          },
          "destinationInstitutionId": {
            "type": "string",
            "pattern": "^INST_[A-Z0-9_-]{1,59}$"
          },
          "bloodType": {
            "$ref": "#/components/schemas/BloodType"
          },
          "componentType": {
            "$ref": "#/components/schemas/ComponentType"
          },
          "quantity": {
            "type": "integer",
            "minimum": 1
          },
          "urgency": {
            "type": "string",
            "enum": [
              "ROUTINE",
              "URGENT",
              "CRITICAL"
            ]
          },
          "requestTime": {
            "type": "string",
            "format": "date-time"
          },
          "eventTime": {
            "type": "string",
            "format": "date-time"
          },
          "correlationId": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "LocalReleaseRequest": {
        "type": "object",
        "description": "Exact request body for POST /local-releases. ROLE-01 and ROLE-02 only.",
        "required": [
          "bloodType",
          "componentType",
          "correlationId",
          "eventTime",
          "quantity",
          "releaseId"
        ],
        "properties": {
          "releaseId": {
            "type": "string",
            "pattern": "^REL_[A-Z0-9_-]{1,56}$"
          },
          "bloodType": {
            "$ref": "#/components/schemas/BloodType"
          },
          "componentType": {
            "$ref": "#/components/schemas/ComponentType"
          },
          "quantity": {
            "type": "integer",
            "minimum": 1
          },
          "eventTime": {
            "type": "string",
            "format": "date-time"
          },
          "correlationId": {
            "type": "string",
            "pattern": "^CORR_[0-9A-F]{32}$"
          }
        },
        "additionalProperties": false
      },
      "ReconciliationRequest": {
        "type": "object",
        "description": "Exact request body for POST /reconciliation. ROLE-01 and ROLE-02 only.",
        "required": [
          "caseId",
          "componentId",
          "correlationId",
          "reasonCode"
        ],
        "properties": {
          "caseId": {
            "type": "string",
            "pattern": "^RECON_[A-Z0-9_-]{1,56}$"
          },
          "componentId": {
            "type": "string",
            "pattern": "^COMP_[A-Z0-9_-]{1,56}$"
          },
          "correlationId": {
            "type": "string",
            "pattern": "^CORR_[0-9A-F]{32}$"
          },
          "reasonCode": {
            "type": "string",
            "enum": [
              "LABEL_RECORD_MISMATCH",
              "POSSIBLE_DUPLICATE",
              "COMPONENT_TYPE_MISMATCH",
              "BLOOD_TYPE_MISMATCH",
              "DATE_MISMATCH",
              "CUSTODY_MISMATCH",
              "STATUS_MISMATCH"
            ]
          }
        },
        "additionalProperties": false
      },
      "ReservationActionRequest": {
        "type": "object",
        "description": "The endpoint enforces an exact body by action: prepare requires preparedAt, preparedEvidenceDigest and preparedEvidenceId; compromise requires reasonCode; all other actions accept only the base fields.",
        "required": [
          "correlationId",
          "eventTime",
          "expectedVersion"
        ],
        "properties": {
          "expectedVersion": {
            "type": "integer",
            "minimum": 1
          },
          "eventTime": {
            "type": "string",
            "format": "date-time"
          },
          "correlationId": {
            "type": "string",
            "pattern": "^CORR_[0-9A-F]{32}$"
          },
          "preparedAt": {
            "type": "string",
            "format": "date-time"
          },
          "preparedEvidenceDigest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "preparedEvidenceId": {
            "type": "string",
            "pattern": "^EVD_[A-Z0-9_-]{1,56}$"
          },
          "reasonCode": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]{2,63}$"
          }
        },
        "additionalProperties": false
      },
      "ReconciliationReasonPolicy": {
        "type": "object",
        "required": [
          "policyVersion",
          "reasons",
          "effect",
          "freeTextAllowed",
          "classification"
        ],
        "properties": {
          "policyVersion": {
            "const": "SYNTHETIC_RECONCILIATION_REASONS_V1"
          },
          "reasons": {
            "type": "array",
            "minItems": 7,
            "maxItems": 7,
            "items": {
              "type": "object",
              "required": [
                "code",
                "label"
              ],
              "properties": {
                "code": {
                  "type": "string"
                },
                "label": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          },
          "effect": {
            "const": "RECONCILIATION_HOLD_ONLY"
          },
          "freeTextAllowed": {
            "const": false
          },
          "classification": {
            "const": "SIMULATION_ONLY"
          }
        },
        "additionalProperties": false
      },
      "Reservation": {
        "type": "object",
        "required": [
          "reservationId",
          "purpose",
          "status",
          "version",
          "sourceInstitutionId",
          "destinationInstitutionId",
          "transferId",
          "localReleaseId",
          "preparedAt",
          "preparedEvidencePresent",
          "updatedAt",
          "components",
          "classification"
        ],
        "properties": {
          "reservationId": {
            "type": "string"
          },
          "purpose": {
            "type": "string",
            "enum": [
              "TRANSFER",
              "LOCAL_RELEASE"
            ]
          },
          "status": {
            "type": "string"
          },
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "sourceInstitutionId": {
            "type": "string"
          },
          "destinationInstitutionId": {
            "type": [
              "string",
              "null"
            ]
          },
          "transferId": {
            "type": [
              "string",
              "null"
            ]
          },
          "localReleaseId": {
            "type": [
              "string",
              "null"
            ]
          },
          "preparedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "preparedEvidencePresent": {
            "type": "boolean"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "components": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "componentId",
                "componentType",
                "inventoryStatus",
                "inventoryVersion"
              ],
              "properties": {
                "componentId": {
                  "type": "string"
                },
                "componentType": {
                  "$ref": "#/components/schemas/ComponentTypeV21"
                },
                "inventoryStatus": {
                  "type": "string"
                },
                "inventoryVersion": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "additionalProperties": false
            }
          },
          "classification": {
            "const": "SIMULATION_ONLY"
          }
        },
        "additionalProperties": false
      },
      "CensusCatchUpRequest": {
        "type": "object",
        "required": [
          "scheduledFor"
        ],
        "properties": {
          "scheduledFor": {
            "type": "string",
            "format": "date-time"
          }
        },
        "additionalProperties": false
      },
      "CensusIndex": {
        "type": "object",
        "required": [
          "scope",
          "displayPolicyVersion",
          "displayBloodTypeOrder",
          "totalColumn",
          "reportAvailability",
          "snapshots",
          "nextCursor",
          "exportAvailable",
          "classification"
        ],
        "properties": {
          "scope": {
            "type": "string",
            "enum": [
              "INSTITUTION",
              "REGULATORY_AGGREGATE"
            ]
          },
          "displayPolicyVersion": {
            "const": "DOH_CENSUS_COLUMN_ORDER_V1"
          },
          "displayBloodTypeOrder": {
            "type": "array",
            "prefixItems": [
              {
                "const": "O_POSITIVE"
              },
              {
                "const": "A_POSITIVE"
              },
              {
                "const": "B_POSITIVE"
              },
              {
                "const": "AB_POSITIVE"
              },
              {
                "const": "O_NEGATIVE"
              },
              {
                "const": "A_NEGATIVE"
              },
              {
                "const": "B_NEGATIVE"
              },
              {
                "const": "AB_NEGATIVE"
              }
            ],
            "minItems": 8,
            "maxItems": 8
          },
          "totalColumn": {
            "const": "CALCULATED"
          },
          "reportAvailability": {
            "type": "string",
            "enum": [
              "EXPORT_AVAILABLE",
              "EXPORT_DISABLED_PENDING_FORMAT"
            ]
