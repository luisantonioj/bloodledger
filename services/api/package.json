{
  "name": "@bloodledger/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "build/src/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test --test-isolation=none build/test/*.test.js",
    "start": "node build/src/server.js",
    "worker": "node build/src/worker-main.js",
    "provision:synthetic-account": "npm run build && node build/src/provision-synthetic-account.js"
  },
  "dependencies": {
    "@fastify/jwt": "10.2.1",
    "@fastify/static": "10.1.3",
    "@grpc/grpc-js": "1.14.4",
    "@hyperledger/fabric-gateway": "1.11.0",
    "fastify": "5.10.0",
    "pg": "8.22.0"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "typescript": "5.9.3"
  }
}
